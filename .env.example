# READ: This is a template. Fill these in with your own details and rename to just `.env`
# Timezone should be a valid IANA name like America/New_York or Europe/London etc. https://en.wikipedia.org/wiki/List_of_tz_database_time_zones


# Database Credentials
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_db_name

# Internal Docker Connection URL
DB_URL=postgres://your_user:your_password@db:5432/your_db_name?sslmode=disable&timezone=your_timezone
